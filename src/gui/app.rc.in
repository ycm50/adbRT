#include <windows.h>
#include "resource.h"
#include "version.h"

// 图标：与 packaging/assets 下同一份像素（矢量母版 adbrt.svg，由 tools/gen-icon.mjs 生成）
// 路径在构建期由 CMake 注入（windres 以 .rc 所在目录为基准解析相对路径，注入绝对路径最稳）。
IDI_ADBRT      ICON "@ADB_ICON_ICO@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    ADB_VERSION_COMMA
 PRODUCTVERSION ADB_VERSION_COMMA
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L
 FILETYPE       0x1L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      ADB_COMPANY_NAME
            VALUE "FileDescription",  ADB_DESCRIPTION
            VALUE "FileVersion",      ADB_VERSION_STR
            VALUE "InternalName",     ADB_PRODUCT_NAME
            VALUE "OriginalFilename", ADB_EXE_NAME
            VALUE "ProductName",      ADB_PRODUCT_NAME
            VALUE "ProductVersion",   ADB_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END