{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "ucrt64-debug",
      "displayName": "UCRT64 Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "A:/msys64/ucrt64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "A:/msys64/ucrt64/bin/g++.exe",
        "CMAKE_RC_COMPILER": "A:/msys64/ucrt64/bin/windres.exe"
      }
    },
    {
      "name": "ucrt64-release",
      "displayName": "UCRT64 Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "A:/msys64/ucrt64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "A:/msys64/ucrt64/bin/g++.exe",
        "CMAKE_RC_COMPILER": "A:/msys64/ucrt64/bin/windres.exe"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug",   "configurePreset": "ucrt64-debug" },
    { "name": "release", "configurePreset": "ucrt64-release" }
  ],
  "testPresets": [
    { "name": "debug",   "configurePreset": "ucrt64-debug",   "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "ucrt64-release", "output": { "outputOnFailure": true } }
  ]
}
